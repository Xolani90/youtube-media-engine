# Copy to .env and fill in real values. Never commit .env.

# --- Autonomy control (Owner override) ---
AUTONOMOUS_ENABLED=false
RUN_MODE=SIMULATION

# --- Cost / R0 enforcement ---
ALLOW_PAID_PROVIDERS=false
MAX_DAILY_SPEND=0
MAX_MONTHLY_SPEND=0
MAX_COST_PER_CONTENT=0
MAX_CUMULATIVE_COST_PER_CONTENT=0

# --- D-C2 external side-effect authorization (ADR-0002 / ADR-0008) ---
# Not an env var: per-action authorization for external side effects
# (publishing, uploading, etc.) lives in the Owner-controlled
# config/authorized_external_actions.json (a JSON array of action-id
# strings, empty by default). Edit that file directly to authorize or
# revoke a specific action; LIVE + AUTONOMOUS_ENABLED are still both
# required in addition to it. See src/state/SideEffectAuthorization.js.

# --- Provider priority (comma-separated, first healthy wins) ---
LLM_PROVIDER_PRIORITY=gemini-free,groq-free,openrouter-free
OPPORTUNITY_PROVIDER_PRIORITY=rss

# --- Provider credentials (leave unset for local-stub/dry-run use) ---
GEMINI_FREE_API_KEY=
GROQ_FREE_API_KEY=
OPENROUTER_FREE_API_KEY=
DEEPSEEK_PAID_API_KEY=

# --- Asset Provisioning (src/providers/asset/PixabayAssetSourceProvider.js) ---
# Required for the autonomous entrypoint's default asset provider to
# return real results. Without it, PixabayAssetSourceProvider.healthCheck()
# returns false and acquireVisualAsset() calls will fail against Pixabay's
# API. Leave unset for local-stub/dry-run use.
PIXABAY_API_KEY=

# --- Research source discovery (src/providers/research/TavilySearchProvider.js) ---
# Required for the autonomous entrypoint's default Research source
# provider to return real results. Without it, TavilySearchProvider.
# healthCheck() returns false and discoverCandidates() returns an empty
# candidate list with a structured failure. The free "Researcher" plan
# grants 1,000 API credits/month at $0, no credit card required; the
# provider fails closed (never falls back to a paid path) once that
# allocation is exhausted. Leave unset for local-stub/dry-run use.
TAVILY_API_KEY=

# --- Storage ---
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/media-engine.db

# --- Scheduler ---
SCHEDULER_DRIVER=github-actions
